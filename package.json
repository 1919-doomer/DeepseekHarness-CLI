{
  "name": "@liaosiyuan123/dshc",
  "version": "0.1.0-alpha.2",
  "description": "Unofficial terminal-native console for DeepSeek Harness",
  "license": "MIT",
  "author": "1919-doomer",
  "private": false,
  "type": "module",
  "homepage": "https://github.com/1919-doomer/DeepseekHarness-CLI#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1919-doomer/DeepseekHarness-CLI.git"
  },
  "bugs": {
    "url": "https://github.com/1919-doomer/DeepseekHarness-CLI/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "cli",
    "terminal",
    "coding-agent"
  ],
  "contentPolicy": {
    "class": "dual-use"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "bin": {
    "dshc": "./dist/cli/bin.js"
  },
  "files": [
    "dist",
    "runtime",
    "README.md",
    "README.zh-CN.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "DISCLOSURE",
    "docs/INSTALLATION.md",
    "docs/COMPATIBILITY.md",
    "docs/DEMO.md",
    "docs/EXTENSIONS.md",
    "docs/assets/dshc-alpha.svg",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "dev": "tsx src/cli/bin.ts",
    "lint": "oxlint src tests scripts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude tests/integration/official-runtime.spec.ts --exclude tests/integration/official-interactive.spec.ts --exclude tests/integration/official-repository-workflow.spec.ts --exclude tests/integration/official-sandbox-policy.spec.ts --exclude tests/integration/official-doctor.spec.ts --exclude tests/integration/official-event-contract.spec.ts",
    "test:official-runtime": "pnpm build && vitest run tests/integration/official-runtime.spec.ts tests/integration/official-interactive.spec.ts tests/integration/official-repository-workflow.spec.ts tests/integration/official-sandbox-policy.spec.ts tests/integration/official-doctor.spec.ts tests/integration/official-event-contract.spec.ts",
    "test:all": "pnpm build && vitest run",
    "test:package": "node scripts/package-smoke.mjs",
    "pack:check": "node scripts/check-package.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "audit:prod": "pnpm audit --prod --audit-level high --registry=https://registry.npmjs.org/",
    "peers": "pnpm peers check",
    "check": "pnpm peers && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm pack:check"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
